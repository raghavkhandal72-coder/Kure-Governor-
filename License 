"""
KURE Governor — Karumanchi Unified Resource Equation
Invented by Raghav Khandal
Inspired by Narasimha Karumanchi's "Data Structures and Algorithms Made Easy"

This module provides a new technology for autonomous algorithm selection
in resource-constrained environments like space data centers.
"""

import math


class KUREGovernor:
    """
    KURE (Karumanchi Unified Resource Equation) Governor Engine.

    This engine evaluates any algorithm and returns:
    - SpaceCode (R_tag C_tag A_tag)
    - KURE Score
    - Decision (APPROVED / FALLBACK)

    The formula: KURE Score = (α·R + β·C) · E^γ

    Where:
        R = Recursion depth (stack memory cost)
        C = Container/heap memory footprint
        E = Energy per operation (derived from time complexity)
        α, β, γ = Spacecraft-specific calibration constants
    """

    def __init__(self, alpha=1.0, beta=1.0, gamma=0.5, threshold=100):
        """
        Initialize the KURE Governor with calibration parameters.

        Args:
            alpha: Weight for recursion factor (default: 1.0)
            beta: Weight for container factor (default: 1.0)
            gamma: Energy exponent (default: 0.5)
            threshold: Maximum safe KURE score (default: 100)
        """
        self.alpha = alpha
        self.beta = beta
        self.gamma = gamma
        self.threshold = threshold

    def _get_spacecode(self, func, n):
        """
        Extract the SpaceCode (R_tag C_tag A_tag) from an algorithm.

        The SpaceCode compresses an algorithm's space personality into
        a unique code that can be decrypted to Big-O space complexity.

        Returns:
            tuple: (R, C, A) where R is recursion depth, C is container size,
                   A is auxiliary variables count
        """
        name = func.__name__.lower()
        r, c, a = 0, 0, 0

        # --- Recursion Detection (R_tag) ---
        # Based on Karumanchi's recursion stack analysis
        if 'recursive' in name or 'fact' in name:
            r = n if n > 1 else 1  # Depth = input size for simple recursion
        elif 'merge' in name:
            r = int(math.log2(n)) if n > 1 else 0  # log n depth
        elif 'binary' in name or 'search' in name:
            r = int(math.log2(n)) if n > 1 else 0
        elif 'fib' in name:
            r = n  # Fibonacci recursion depth
        else:
            r = 0  # No recursion

        # --- Container Detection (C_tag) ---
        # Based on Karumanchi's fixed + variable part analysis
        if 'arr' in name or 'list' in name or 'sum' in name:
            c = n  # Array of size n
        elif 'merge' in name:
            c = n  # Temporary array in merge
        elif 'matrix' in name:
            c = n * n  # 2D matrix
        elif 'dp' in name or 'dynamic' in name:
            c = n  # DP table
        elif 'fact' in name and 'iterative' in name:
            c = 0  # Iterative factorial uses no extra container
        elif 'iterative' in name:
            c = 0  # Iterative algorithms typically O(1) extra
        else:
            c = 0  # Default: no container

        # --- Auxiliary Variables (A_tag) ---
        # Karumanchi: fixed part of space complexity
        # Most algorithms use 2-3 auxiliary variables (i, j, temp)
        a = 3  # Default estimate (loops use ~2-3 variables)
        if r == 0 and c == 0:
            a = 0  # Pure O(1) algorithms

        return r, c, a

    def _estimate_energy(self, func, n):
        """
        Estimate energy cost derived from time complexity.

        Energy ∝ Time Complexity × Clock Cycles
        Based on Karumanchi's time complexity analysis.
        """
        name = func.__name__.lower()

        if 'binary' in name or 'search' in name:
            return math.log2(n) if n > 1 else 1
        elif 'merge' in name:
            return n * (math.log2(n) if n > 1 else 1)
        elif 'fact' in name or 'fib' in name:
            return n
        elif 'loop' in name or 'iterative' in name:
            return n
        elif 'dp' in name or 'dynamic' in name:
            return n  # DP typically O(n)
        elif 'matrix' in name:
            return n * n
        else:
            return n  # Default linear

    def evaluate(self, func, n):
        """
        Evaluate an algorithm and return the KURE analysis.

        Args:
            func: The algorithm function to evaluate
            n: Input size

        Returns:
            dict: Contains SpaceCode, KURE Score, Decision, and parameters
        """
        r, c, a = self._get_spacecode(func, n)
        e = self._estimate_energy(func, n)

        # The Core Formula: KURE Score = (α·R + β·C) · E^γ
        kure_score = (self.alpha * r + self.beta * c) * (e ** self.gamma)

        # Decision Logic
        if kure_score <= self.threshold:
            decision = "APPROVED ✅ (Safe for execution)"
            status = "SAFE"
        else:
            decision = "FALLBACK ⚠️ (Switch to safe algorithm)"
            status = "UNSAFE"

        # Build SpaceCode string
        r_tag = f"R{r}"
        c_tag = f"C{c}"
        a_tag = f"A{a}"
        spacecode = f"{r_tag} {c_tag} {a_tag}"

        # Decrypt to Big-O
        max_order = max(r, c)
        if max_order == 0:
            big_o = "O(1)"
        elif max_order == int(math.log2(n)) if n > 1 else 0:
            big_o = "O(log n)"
        else:
            big_o = f"O(n{'²' if max_order == n*n else ''})"

        return {
            "Algorithm": func.__name__,
            "Input Size (n)": n,
            "SpaceCode": spacecode,
            "Space Complexity (Big-O)": big_o,
            "KURE Score": round(kure_score, 2),
            "Decision": decision,
            "Status": status,
            "Parameters": {
                "Alpha (α)": self.alpha,
                "Beta (β)": self.beta,
                "Gamma (γ)": self.gamma,
                "Threshold": self.threshold
            }
        }

    def compare(self, func1, func2, n):
        """
        Compare two algorithms and recommend the best one for space.

        Args:
            func1: First algorithm
            func2: Second algorithm
            n: Input size

        Returns:
            dict: Comparison results with recommendation
        """
        res1 = self.evaluate(func1, n)
        res2 = self.evaluate(func2, n)

        if res1["KURE Score"] < res2["KURE Score"]:
            winner = func1.__name__
        elif res2["KURE Score"] < res1["KURE Score"]:
            winner = func2.__name__
        else:
            winner = "TIE — Both equally efficient"

        return {
            "Algorithm 1": res1,
            "Algorithm 2": res2,
            "Winner (Lowest KURE)": winner,
            "Recommendation": f"Use '{winner}' for space missions."
        }


