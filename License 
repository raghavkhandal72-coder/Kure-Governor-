    # Demo 1: Recursive Factorial
    def factorial(n):
        if n <= 1:
            return 1
        return n * factorial(n - 1)

    governor = KUREGovernor(alpha=1, beta=1, gamma=0.5, threshold=50)
    result = governor.evaluate(factorial, 10)

    print("\n📊 Recursive Factorial (n=10):")
    for key, value in result.items():
        print(f"   {key}: {value}")

    # Demo 2: Compare with Iterative
    def factorial_iterative(n):
        res = 1
        for i in range(1, n + 1):
            res *= i
        return res

    print("\n🔄 Comparison: Recursive vs Iterative Factorial:")
    comparison = governor.compare(factorial, factorial_iterative, 10)
    print(f"   Recursive KURE: {comparison['Algorithm 1']['KURE Score']}")
    print(f"   Iterative KURE: {comparison['Algorithm 2']['KURE Score']}")
    print(f"   🏆 Winner: {comparison['Winner']}")